{
  "expo": {
    "name": "CallVault",
    "slug": "callvault",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "splash": {
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.subrahmanyam.callvault",
      "permissions": [
        "RECORD_AUDIO",
        "READ_PHONE_STATE",
        "READ_CALL_LOG",
        "READ_CONTACTS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS",
        "WRITE_EXTERNAL_STORAGE"
      ]
    }
  }
}
